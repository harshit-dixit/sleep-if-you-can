<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    
    <!-- Manrope ExtraLight (200) -->
    <font
        android:font="@font/manrope_extralight"
        android:fontWeight="200"
        android:fontStyle="normal"
        app:font="@font/manrope_extralight"
        app:fontWeight="200"
        app:fontStyle="normal" />

    <!-- Manrope Light (300) -->
    <font
        android:font="@font/manrope_light"
        android:fontWeight="300"
        android:fontStyle="normal"
        app:font="@font/manrope_light"
        app:fontWeight="300"
        app:fontStyle="normal" />

    <!-- Manrope Regular (400) -->
    <font
        android:font="@font/manrope_regular"
        android:fontWeight="400"
        android:fontStyle="normal"
        app:font="@font/manrope_regular"
        app:fontWeight="400"
        app:fontStyle="normal" />

    <!-- Manrope Medium (500) -->
    <font
        android:font="@font/manrope_medium"
        android:fontWeight="500"
        android:fontStyle="normal"
        app:font="@font/manrope_medium"
        app:fontWeight="500"
        app:fontStyle="normal" />

    <!-- Manrope SemiBold (600) -->
    <font
        android:font="@font/manrope_semibold"
        android:fontWeight="600"
        android:fontStyle="normal"
        app:font="@font/manrope_semibold"
        app:fontWeight="600"
        app:fontStyle="normal" />

    <!-- Manrope Bold (700) -->
    <font
        android:font="@font/manrope_bold"
        android:fontWeight="700"
        android:fontStyle="normal"
        app:font="@font/manrope_bold"
        app:fontWeight="700"
        app:fontStyle="normal" />

    <!-- Manrope ExtraBold (800) -->
    <font
        android:font="@font/manrope_extrabold"
        android:fontWeight="800"
        android:fontStyle="normal"
        app:font="@font/manrope_extrabold"
        app:fontWeight="800"
        app:fontStyle="normal" />
        
</font-family>
